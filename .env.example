# Copie este arquivo para ".env" e coloque sua chave. O .env NÃO vai para o GitHub (está no .gitignore).
# Crie a chave grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: troque o modelo se o padrão for descontinuado (lista em https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-3.8-flash
